config {
  type: "table",
  schema: "gold",
  tags: ["gold"],
  dependOnDependencyAssertions: true
}

-- Gold: chuva diária por estação do INMET, com a bacia em que a estação cai. `horas_sem_medicao` mostra o buraco da
-- origem em vez de escondê-lo dentro de um zero. `ultima_hora_com_dado` é por estação: o zip do ano corrente
-- atrasa semanas, e um dia sem linhas não quer dizer um dia sem chuva. Sem KPI nem comparação entre estações (ADR 012).
--
-- `bacia` é o ponto em polígono do ADR 026, com os contornos do ONS (silver.ons_bacia_contorno), e é só uma coluna ao
-- lado: a chuva continua por estação e NÃO é agregada por bacia (a regra de agregação é da Alup). `bacia` fica nula
-- quando a estação cai fora de todo contorno (39% das estações em 03/10/2026) ou exatamente sobre uma borda
-- (ST_CONTAINS não conta a fronteira); a linha da estação continua na Gold (LEFT JOIN). Estação dentro de mais de um
-- polígono fica com o de MENOR ÁREA (ST_AREA), e o nome da bacia desempata. Vale o contorno da data de referência
-- mais recente de cada bacia.
WITH contorno_vigente AS (
  SELECT nome_bacia, contorno, ST_AREA(contorno) AS area_m2
  FROM ${ref("silver", "ons_bacia_contorno")}
  QUALIFY ROW_NUMBER() OVER (PARTITION BY nome_bacia ORDER BY data_referencia DESC) = 1
),

-- Uma linha por estação, não por dia: a junção espacial roda ~600 vezes, não ~200 mil. A coordenada é a da leitura mais recente.
estacao_ponto AS (
  SELECT
    estacao,
    ST_GEOGPOINT(
      CAST(ARRAY_AGG(longitude ORDER BY data_referencia DESC LIMIT 1)[OFFSET(0)] AS FLOAT64),
      CAST(ARRAY_AGG(latitude ORDER BY data_referencia DESC LIMIT 1)[OFFSET(0)] AS FLOAT64)
    ) AS ponto
  FROM ${ref("silver", "inmet_precipitacao")}
  GROUP BY estacao
),

estacao_bacia AS (
  SELECT
    e.estacao,
    ARRAY_AGG(c.nome_bacia IGNORE NULLS ORDER BY c.area_m2 ASC, c.nome_bacia ASC LIMIT 1)[SAFE_OFFSET(0)] AS bacia
  FROM estacao_ponto AS e
  LEFT JOIN contorno_vigente AS c ON ST_CONTAINS(c.contorno, e.ponto)
  GROUP BY e.estacao
)

SELECT
  p.estacao,
  ANY_VALUE(p.nome_estacao) AS nome_estacao,
  ANY_VALUE(p.uf) AS uf,
  b.bacia,
  p.data_referencia,
  SUM(p.precipitacao_mm) AS precipitacao_mm_dia,
  COUNTIF(p.precipitacao_mm IS NOT NULL) AS horas_com_medicao,
  COUNTIF(p.precipitacao_mm IS NULL) AS horas_sem_medicao,
  MAX(MAX(IF(p.precipitacao_mm IS NOT NULL, TIMESTAMP_ADD(TIMESTAMP(p.data_referencia), INTERVAL p.hora_utc HOUR), NULL)))
    OVER (PARTITION BY p.estacao) AS ultima_hora_com_dado
FROM ${ref("silver", "inmet_precipitacao")} AS p
LEFT JOIN estacao_bacia AS b ON b.estacao = p.estacao
GROUP BY p.estacao, b.bacia, p.data_referencia

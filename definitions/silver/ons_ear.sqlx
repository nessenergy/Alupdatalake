config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "submercado"],
    nonNull: ["data_referencia", "submercado"],
    rowConditions: [
      "submercado IN ('N','NE','S','SE')",
      "ear_max_mwmes >= 0",
      "ear_verificada_mwmes >= 0",
      "ear_verificada_percentual BETWEEN 0 AND 100"
    ]
  }
}

-- Silver: EAR diária higienizada e deduplicada.
-- Dedup por (data_referencia, submercado): o ONS revisa dado publicado, então
-- vence a ingestão mais recente — mesma regra do ons_carga.
-- Faixa do percentual: EAR verificada é fração da capacidade máxima do
-- próprio subsistema, então 0-100 é o intervalo físico completo (diferente
-- do percentual de ENA, que compara com uma média histórica e pode passar
-- de 100 — ver definitions/silver/ons_ena.sqlx).
SELECT
  data_referencia,
  submercado,
  CAST(NULL AS STRING) AS codigo_usina,  -- EAR é agregada por subsistema
  CAST(NULL AS STRING) AS agente_ccee,   -- idem
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS, não a CCEE
  nome_subsistema,
  ear_max_mwmes,
  ear_verificada_mwmes,
  ear_verificada_percentual,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_ear")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, submercado
  ORDER BY _ingestao_timestamp DESC
) = 1

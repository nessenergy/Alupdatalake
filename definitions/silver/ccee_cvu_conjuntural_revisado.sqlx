config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["periodo_apuracao_ccee", "sigla_parcela", "leilao", "produto"],
    nonNull: ["data_referencia", "periodo_apuracao_ccee", "sigla_parcela", "leilao", "produto"],
    rowConditions: [
      "custo_combustivel >= 0",
      "cvu_conjuntural >= 0"
    ]
  }
}

-- Silver: CVU conjuntural revisado, higienizada e deduplicada pela publicação mais recente.
-- Chave: (mês, parcela, leilão, produto). O código de modelo de preço se
-- repete no mês (28 casos em 2025 e em 2026) e não identifica a linha.
SELECT
  data_referencia,
  CAST(NULL AS STRING) AS submercado,
  CAST(NULL AS STRING) AS codigo_usina,
  cnpj_agente_vendedor AS agente_ccee,
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  periodo_apuracao_ccee,
  versao_publicacao,
  agente_vendedor,
  cnpj_agente_vendedor,
  sigla_parcela,
  tipo_combustivel,
  leilao,
  produto,
  custo_combustivel,
  cvu_conjuntural,
  codigo_modelo_preco,
  inicio_suprimento,
  termino_suprimento,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ccee_cvu_conjuntural_revisado")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY periodo_apuracao_ccee, sigla_parcela, leilao, produto
  ORDER BY versao_publicacao DESC, _ingestao_timestamp DESC
) = 1

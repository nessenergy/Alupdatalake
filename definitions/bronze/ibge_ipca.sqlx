config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: IPCA (IBGE/SIDRA, agregado 1737).
-- Append-only: reprocessar a mesma janela insere de novo; a Silver deduplica.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia     DATE      NOT NULL OPTIONS(description="Primeiro dia do mês de referência"),
  periodo             STRING    NOT NULL OPTIONS(description="AAAAMM, como o IBGE devolve"),
  variavel_id         STRING    NOT NULL OPTIONS(description="63 = variação mensal; 69 = acumulada no ano"),
  variavel            STRING    NOT NULL OPTIONS(description="Nome da variável no SIDRA"),
  unidade             STRING    NOT NULL OPTIONS(description="Unidade de medida, normalmente %"),
  valor               NUMERIC   NOT NULL OPTIONS(description="Valor publicado"),

  _ingestao_id        STRING    NOT NULL,
  _ingestao_timestamp TIMESTAMP NOT NULL,
  _fonte              STRING    NOT NULL,
  _schema_versao      STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, variavel_id
OPTIONS(description="IPCA mensal — camada Bronze, append-only");

config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "patamar", "codigo_usina_pdp"],
    nonNull: ["data_referencia", "patamar", "codigo_usina_pdp"],
    rowConditions: [
      "patamar BETWEEN 1 AND 48",
      "previsao_mw >= 0",
      "programado_mw >= 0"
    ]
  }
}

-- Silver: Previsão versus programado de eólicas e solares, higienizada e deduplicada. Aditivo 01.
-- Dedup pela chave natural (dia, patamar, usina), vence a ingestão mais recente: o ONS
-- avisa que o dado publicado pode ser revisado.
SELECT
  data_referencia,
  CAST(NULL AS STRING) AS submercado,    -- a origem não traz subsistema, só a usina do PDP
  CAST(NULL AS STRING) AS codigo_usina,  -- o código do PDP não é o CEG; fica em codigo_usina_pdp
  CAST(NULL AS STRING) AS agente_ccee,   -- o ONS não usa perfil da CCEE
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS
  patamar,
  codigo_usina_pdp,
  nome_usina,
  previsao_mw,
  programado_mw,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_programacao_previsao")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, patamar, codigo_usina_pdp
  ORDER BY _ingestao_timestamp DESC
) = 1

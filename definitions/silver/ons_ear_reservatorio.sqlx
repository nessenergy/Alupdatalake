config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "reservatorio"],
    nonNull: ["data_referencia", "reservatorio", "submercado"],
    rowConditions: [
      "submercado IN ('N','NE','S','SE')",
      "subsistema_jusante IS NULL OR subsistema_jusante IN ('N','NE','S','SE')",
      // Sem teto em 100: chegou a 182% em 2026. Nulo é reservatório sem medição.
      "ear_percentual IS NULL OR ear_percentual >= 0"
    ]
  }
}

-- Silver: EAR diária por reservatório, higienizada e deduplicada.
-- Dedup por (data_referencia, reservatorio): vence a ingestão mais recente.
SELECT
  data_referencia,
  submercado,
  CAST(NULL AS STRING) AS codigo_usina,  -- a origem identifica o reservatório, não traz CEG
  CAST(NULL AS STRING) AS agente_ccee,   -- o ONS não usa perfil da CCEE
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS
  reservatorio,
  codigo_reservatorio_planejamento,
  tipo_reservatorio,
  bacia,
  ree,
  subsistema_jusante,
  ear_proprio_mwmes,
  ear_jusante_mwmes,
  ear_max_proprio_mwmes,
  ear_max_jusante_mwmes,
  ear_percentual,
  ear_total_mwmes,
  ear_max_total_mwmes,
  contribuicao_ear_bacia,
  contribuicao_ear_max_bacia,
  contribuicao_ear_subsistema,
  contribuicao_ear_max_subsistema,
  contribuicao_ear_subsistema_jusante,
  contribuicao_ear_max_subsistema_jusante,
  contribuicao_ear_sin,
  contribuicao_ear_max_sin,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_ear_reservatorio")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, reservatorio
  ORDER BY _ingestao_timestamp DESC
) = 1

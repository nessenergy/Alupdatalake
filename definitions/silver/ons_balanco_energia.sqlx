config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["instante", "subsistema"],
    nonNull: ["data_referencia", "instante", "subsistema"],
    rowConditions: [
      "subsistema IN ('N','NE','S','SE','SIN')",
      "geracao_hidraulica_mwmed >= 0",
      "geracao_termica_mwmed >= 0",
      "geracao_eolica_mwmed >= 0",
      "geracao_solar_mwmed >= 0"
    ]
  }
}

-- Silver: Balanço de energia horário nos subsistemas, higienizada e deduplicada. Aditivo 01.
-- Dedup pela chave natural, vence a ingestão mais recente (o ONS revisa dado publicado).
SELECT
  data_referencia,
  IF(subsistema = 'SIN', NULL, subsistema) AS submercado,  -- a linha SIN é o total do sistema, não um submercado
  CAST(NULL AS STRING) AS codigo_usina,  -- dado agregado, sem usina
  CAST(NULL AS STRING) AS agente_ccee,   -- o ONS não usa perfil da CCEE
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS
  EXTRACT(HOUR FROM instante) AS hora,
  instante,
  subsistema,
  nome_subsistema,
  geracao_hidraulica_mwmed,
  geracao_termica_mwmed,
  geracao_eolica_mwmed,
  geracao_solar_mwmed,
  carga_mwmed,
  intercambio_mwmed,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_balanco_energia")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY instante, subsistema
  ORDER BY _ingestao_timestamp DESC
) = 1

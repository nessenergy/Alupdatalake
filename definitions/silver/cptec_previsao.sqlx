config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["cidade_id", "data_referencia", "data_emissao"],
    nonNull: ["cidade_id", "data_referencia", "data_emissao", "codigo_tempo"],
    rowConditions: [
      "temperatura_minima_c <= temperatura_maxima_c",
      "temperatura_maxima_c BETWEEN -30 AND 55 AND temperatura_minima_c BETWEEN -30 AND 55",
      "indice_uv BETWEEN 0 AND 20",
      "data_referencia BETWEEN data_emissao AND DATE_ADD(data_emissao, INTERVAL 15 DAY)"
    ]
  }
}

-- Silver: previsão do CPTEC deduplicada por cidade, dia previsto e emissão. Cada emissão fica, porque a pergunta
-- "quanto a previsão mudou de um dia para o outro" só se responde com o histórico delas. Reprocessar a mesma emissão
-- não duplica: vale a ingestão mais recente.
-- `submercado` fica nulo: a previsão é por cidade, e mapear cidade a submercado é regra da Alup. Sem usina nem agente.
SELECT
  data_referencia,
  CAST(NULL AS STRING) AS submercado,
  CAST(NULL AS STRING) AS codigo_usina,
  CAST(NULL AS STRING) AS agente_ccee,
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,
  cidade_id, cidade, uf, data_emissao, codigo_tempo,
  temperatura_maxima_c, temperatura_minima_c, indice_uv,
  _ingestao_id, _ingestao_timestamp
FROM ${ref("bronze", "cptec_previsao")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY cidade_id, data_referencia, data_emissao
  ORDER BY _ingestao_timestamp DESC
) = 1

config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["instante"],
    nonNull: ["data_referencia", "instante"],
    rowConditions: [
      "geracao_exportacao_termica_mwmed >= 0",
      "exportacao_argentina_mwmed >= 0",
      "exportacao_uruguai_mwmed >= 0"
    ]
  }
}

-- Silver: Geração comercial horária para exportação internacional, higienizada e deduplicada. Aditivo 01.
-- Dedup pela chave natural, vence a ingestão mais recente (o ONS revisa dado publicado).
SELECT
  data_referencia,
  CAST(NULL AS STRING) AS submercado,  -- total do SIN para exportação
  CAST(NULL AS STRING) AS codigo_usina,  -- dado agregado, sem usina
  CAST(NULL AS STRING) AS agente_ccee,   -- o ONS não usa perfil da CCEE
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS
  EXTRACT(HOUR FROM instante) AS hora,
  instante,
  geracao_exportacao_evt_argentina_mwmed,
  geracao_exportacao_evt_uruguai_mwmed,
  geracao_exportacao_termica_mwmed,
  exportacao_argentina_mwmed,
  exportacao_uruguai_mwmed,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_geracao_exportacao")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY instante
  ORDER BY _ingestao_timestamp DESC
) = 1

config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: CVU conjuntural revisado por agente vendedor, mensal (CCEE, dados abertos). Aditivo 01.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia         DATE      NOT NULL OPTIONS(description="Primeiro dia do mês de referência"),
  periodo_apuracao_ccee   STRING    NOT NULL OPTIONS(description="AAAA-MM, como a CCEE declara"),
  versao_publicacao       DATE      NOT NULL OPTIONS(description="last_modified do recurso no CKAN (ADR 016)"),
  agente_vendedor         STRING    NOT NULL,
  cnpj_agente_vendedor    STRING    NOT NULL,
  sigla_parcela           STRING    NOT NULL,
  tipo_combustivel        STRING    NOT NULL,
  leilao                  STRING    NOT NULL,
  produto                 STRING    NOT NULL,
  custo_combustivel       NUMERIC   NOT NULL OPTIONS(description="R$/MWh"),
  cvu_conjuntural         NUMERIC   NOT NULL OPTIONS(description="R$/MWh"),
  codigo_modelo_preco     STRING    NOT NULL,
  inicio_suprimento       DATE      NOT NULL,
  termino_suprimento      DATE      NOT NULL,

  _ingestao_id            STRING    NOT NULL,
  _ingestao_timestamp     TIMESTAMP NOT NULL,
  _fonte                  STRING    NOT NULL,
  _schema_versao          STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, codigo_modelo_preco
OPTIONS(description="CVU conjuntural revisado por agente vendedor — camada Bronze, append-only");

config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: cadastro de empreendimentos de geração (ANEEL/SIGA).
-- Snapshot completo a cada execução; append-only preserva o histórico do cadastro.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia         DATE      NOT NULL OPTIONS(description="Data do conjunto declarada pela ANEEL"),
  codigo_usina            STRING    NOT NULL OPTIONS(description="CodCEG — chave única do empreendimento"),
  nome                    STRING    NOT NULL,
  uf                      STRING    OPTIONS(description="UF principal"),
  tipo_geracao            STRING    OPTIONS(description="UHE, PCH, EOL, UFV, UTE, CGH"),
  fase                    STRING    OPTIONS(description="Operação, Construção, Construção não iniciada"),
  origem_combustivel      STRING,
  fonte_combustivel       STRING,
  data_entrada_operacao   DATE,
  potencia_outorgada_kw   NUMERIC,
  potencia_fiscalizada_kw NUMERIC,
  garantia_fisica_kw      NUMERIC,

  _ingestao_id            STRING    NOT NULL,
  _ingestao_timestamp     TIMESTAMP NOT NULL,
  _fonte                  STRING    NOT NULL,
  _schema_versao          STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY codigo_usina, uf
OPTIONS(description="Cadastro SIGA/ANEEL — camada Bronze, append-only");

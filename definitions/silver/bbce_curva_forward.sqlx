config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "curva", "vertice_em"],
    nonNull: ["data_referencia", "curva", "vertice_em", "preco_reais_mwh"],
    rowConditions: [
      "preco_reais_mwh >= 0",
      "vertice_em >= data_referencia",
      "horizonte_dias >= 0"
    ]
  }
}

-- Silver: curva forward higienizada e deduplicada.
-- Dedup por (data_referencia, curva, vertice_em): a BBCE revisa a curva
-- publicada — daí a coluna `atualizado_em` existir —, então vence a ingestão
-- mais recente. Mesmo critério do ONS e da CCEE, pela mesma razão.
-- Faixas (issue #110): curva forward precifica o futuro — vértice no passado
-- é erro de origem. O `horizonte_dias` é derivado nesta própria view, e a
-- condição o protege de virar negativo se a derivação mudar.
SELECT
  data_referencia,
  curva,
  vertice_em,
  -- Quantos dias à frente o vértice olha. É o eixo que torna curvas de dias
  -- diferentes comparáveis entre si, e o BigQuery não o deriva sozinho.
  DATE_DIFF(vertice_em, data_referencia, DAY) AS horizonte_dias,
  FORMAT_DATE('%Y-%m', vertice_em) AS vertice_periodo,
  preco_reais_mwh,
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem não declara período próprio
  CAST(NULL AS STRING) AS submercado,    -- a curva publicada é do produto, não do submercado
  CAST(NULL AS STRING) AS codigo_usina,
  CAST(NULL AS STRING) AS agente_ccee,   -- preço de mercado, não posição de agente
  origem_dado,
  identidade,
  id_origem,
  atualizado_em,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "bbce_curva_forward")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, curva, vertice_em
  ORDER BY _ingestao_timestamp DESC
) = 1

config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: Intercâmbio horário entre subsistemas (ONS). Aditivo 01.
--
-- `intercambio_programado_mwmed` só existe na origem a partir de 2026
-- (confirmado no cabeçalho real em 28/09/2026); nula em 2024 e 2025. Em
-- 28-29/09/2026 a tabela já existia com NOT NULL nessa coluna — um
-- `ALTER TABLE ... DROP NOT NULL` rodou uma vez em `dev` para corrigir.
-- Não fica aqui: `DROP NOT NULL` não é idempotente no BigQuery (erro se a
-- coluna já é anulável), e `CREATE TABLE IF NOT EXISTS` não evolui coluna
-- de tabela existente — só serve daqui para a frente, num ambiente novo,
-- onde já nasce sem NOT NULL.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia                   DATE       NOT NULL OPTIONS(description="Dia do instante"),
  instante                          DATETIME   NOT NULL OPTIONS(description="Hora de referência"),
  subsistema_origem                 STRING     NOT NULL OPTIONS(description="N, NE, S, SE"),
  subsistema_destino                STRING     NOT NULL OPTIONS(description="N, NE, S, SE"),
  intercambio_mwmed                 NUMERIC    NOT NULL OPTIONS(description="Intercâmbio verificado, MWmed"),
  intercambio_programado_mwmed      NUMERIC             OPTIONS(description="Intercâmbio programado, MWmed; pode ser negativo; nulo antes de 2026"),

  _ingestao_id        STRING    NOT NULL,
  _ingestao_timestamp TIMESTAMP NOT NULL,
  _fonte              STRING    NOT NULL,
  _schema_versao      STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, subsistema_origem, subsistema_destino
OPTIONS(description="Intercâmbio horário entre subsistemas — camada Bronze, append-only");

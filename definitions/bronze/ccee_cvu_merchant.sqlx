config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: CVU merchant por empreendimento térmico, mensal (CCEE, dados abertos). Aditivo 01.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia         DATE      NOT NULL OPTIONS(description="Primeiro dia do mês de referência"),
  periodo_apuracao_ccee   STRING    NOT NULL OPTIONS(description="AAAA-MM, como a CCEE declara"),
  versao_publicacao       DATE      NOT NULL OPTIONS(description="last_modified do recurso no CKAN (ADR 016)"),
  codigo_modelo_preco     STRING    NOT NULL,
  empreendimento          STRING    NOT NULL,
  despacho                STRING    NOT NULL OPTIONS(description="Número da resolução/despacho regulatório"),
  tipo_combustivel        STRING    NOT NULL,
  cvu_sem_custo_fixo      NUMERIC   NOT NULL OPTIONS(description="R$/MWh"),
  cvu_com_custo_fixo      NUMERIC            OPTIONS(description="R$/MWh; nulo quando o modelo não calcula essa parcela"),
  recupera_custo_fixo     BOOL      NOT NULL,
  inicio_suprimento       DATE      NOT NULL,
  termino_suprimento      DATE      NOT NULL,
  origem_cotacao          STRING    NOT NULL,
  periodo_cotacao         STRING    NOT NULL OPTIONS(description="AAAA-MM do mês de referência da cotação de combustível"),

  _ingestao_id            STRING    NOT NULL,
  _ingestao_timestamp     TIMESTAMP NOT NULL,
  _fonte                  STRING    NOT NULL,
  _schema_versao          STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, codigo_modelo_preco
OPTIONS(description="CVU merchant por empreendimento térmico — camada Bronze, append-only");

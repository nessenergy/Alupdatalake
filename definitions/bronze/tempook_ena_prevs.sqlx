config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: catálogo dos arquivos diários de previsão de ENA do TempoOK (ADR 019).
--
-- Catálogo, não conteúdo: o tar.gz inteiro fica no bucket raw e esta tabela
-- aponta para ele. Cada tar.gz traz 7 arquivos .txt, um por revisão do PMO, com
-- uma tabela de ENA por subsistema e semana (verificado em 21/09/2026). Extrair
-- esses números é escopo futuro e depende de a Alup dizer quais importam.
--
-- `modelo` é coluna desde o começo porque a Alup vai indicar outros caminhos e
-- o Bronze é append-only: cada combinação nova, sem a coluna, pediria mudança
-- de schema.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia     DATE      NOT NULL OPTIONS(description="Dia do arquivo, o da data no nome"),
  modelo              STRING    NOT NULL OPTIONS(description="Combinação de modelos, como aparece no nome do arquivo"),
  caminho_origem      STRING    NOT NULL OPTIONS(description="Caminho pedido ao TempoOK, como consta na origem"),
  nome_arquivo        STRING    NOT NULL,
  uri_arquivo         STRING        NULL OPTIONS(description="gs:// do tar.gz arquivado; nulo em dry-run"),
  tamanho_bytes       INT64     NOT NULL,
  sha256              STRING    NOT NULL OPTIONS(description="Identifica republicação corrigida sem reabrir o arquivo"),
  content_type        STRING    NOT NULL OPTIONS(description="application/gzip; o servidor diz octet-stream"),

  _ingestao_id        STRING    NOT NULL,
  _ingestao_timestamp TIMESTAMP NOT NULL,
  _fonte              STRING    NOT NULL,
  _schema_versao      STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, modelo
OPTIONS(description="Catálogo de arquivos diários de previsão de ENA do TempoOK — camada Bronze, append-only");

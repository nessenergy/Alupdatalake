# GCP
GCP_PROJECT_ID=alupar-dev-alupdata

# BigQuery
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# Cloud Storage
GCS_BUCKET_RAW=alupar-dev-alupdata-raw

# Cloud Composer
COMPOSER_BUCKET=alupar-dev-alupdata-composer-dags

# HTTP dos conectores
HTTP_TIMEOUT=30
HTTP_MAX_TENTATIVAS=3

# Extrai e valida sem gravar em GCS/BigQuery
DRY_RUN=false

# Credenciais NÃO vão aqui (cláusula 8.5). Antes do ambiente GCP elas ficam no
# cofre local, fora do repositório; depois, no Secret Manager.
# Ver docs/runbook/credenciais.md.
#
# ALUPDATA_SECRETS_LOCAIS=1
# ALUPDATA_SECRETS_ARQUIVO=~/.alupdata/segredos.env

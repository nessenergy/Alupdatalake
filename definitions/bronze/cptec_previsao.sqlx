config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: previsão do tempo do CPTEC/INPE para as 27 capitais (webservice XML). Append-only: cada execução acrescenta
-- a previsão vigente, e a sequência de emissões forma o histórico de previsões, que a origem não guarda.
CREATE TABLE IF NOT EXISTS ${self()} (
  cidade_id            INT64   NOT NULL OPTIONS(description="Id da cidade no CPTEC, ex.: 244 (São Paulo)"),
  cidade               STRING  NOT NULL OPTIONS(description="Nome da capital"),
  uf                   STRING  NOT NULL OPTIONS(description="Sigla da UF"),
  data_referencia      DATE    NOT NULL OPTIONS(description="Dia previsto"),
  data_emissao         DATE    NOT NULL OPTIONS(description="Dia em que o CPTEC emitiu a previsão (campo atualizacao)"),
  codigo_tempo         STRING  NOT NULL OPTIONS(description="Código de tempo do CPTEC, ex.: c, pn, ps; ver o dicionário"),
  temperatura_maxima_c INT64   NOT NULL OPTIONS(description="Temperatura máxima prevista, em graus Celsius"),
  temperatura_minima_c INT64   NOT NULL OPTIONS(description="Temperatura mínima prevista, em graus Celsius"),
  indice_uv            NUMERIC NOT NULL OPTIONS(description="Índice ultravioleta previsto"),

  _ingestao_id        STRING    NOT NULL OPTIONS(description="Identificador da execução de ingestão"),
  _ingestao_timestamp TIMESTAMP NOT NULL OPTIONS(description="Quando o registro entrou no lake"),
  _fonte              STRING    NOT NULL OPTIONS(description="Identificador da fonte"),
  _schema_versao      STRING    NOT NULL OPTIONS(description="Versão do contrato lido na origem")
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY cidade_id, data_referencia
OPTIONS(description="Previsão do tempo do CPTEC por capital — camada Bronze, append-only");

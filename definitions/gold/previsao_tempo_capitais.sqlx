config {
  type: "table",
  schema: "gold",
  tags: ["gold"],
  dependOnDependencyAssertions: true
}

-- Gold: a previsão do tempo vigente das capitais, a emissão mais recente de cada dia previsto. Responde "o que o CPTEC
-- prevê hoje para cada capital nos próximos dias". `antecedencia_dias` é quantos dias antes o dia foi previsto
-- (0 é previsão do próprio dia). `amplitude_termica_c` é a máxima menos a mínima. Sem chuva em mm: a origem não a traz.
SELECT
  data_referencia,
  cidade_id, cidade, uf,
  data_emissao,
  DATE_DIFF(data_referencia, data_emissao, DAY) AS antecedencia_dias,
  codigo_tempo,
  temperatura_maxima_c,
  temperatura_minima_c,
  temperatura_maxima_c - temperatura_minima_c AS amplitude_termica_c,
  indice_uv
FROM ${ref("silver", "cptec_previsao")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY cidade_id, data_referencia
  ORDER BY data_emissao DESC
) = 1

config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "submercado"],
    nonNull: ["data_referencia", "submercado"],
    rowConditions: [
      "submercado IN ('N','NE','S','SE')",
      "carga_mwmed > 0"
    ]
  }
}

-- Silver: carga diária higienizada e deduplicada.
-- Dedup por (data_referencia, submercado): o ONS revisa dado publicado, então
-- vence a ingestão mais recente.
-- Faixas (issue #110): a sigla do submercado é a chave de cruzamento com a
-- CCEE — sigla nova sem revisão do contrato entraria como dado silenciosamente
-- errado. Carga nula ou negativa em MWmed não existe fisicamente.
SELECT
  data_referencia,
  submercado,
  CAST(NULL AS STRING) AS codigo_usina,  -- carga é agregada por subsistema
  CAST(NULL AS STRING) AS agente_ccee,   -- idem
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  nome_subsistema,
  carga_mwmed,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_carga")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, submercado
  ORDER BY _ingestao_timestamp DESC
) = 1

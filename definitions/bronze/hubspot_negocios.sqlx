config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: negócios do CRM Hubspot.
-- Append-only: cada execução insere a versão do negócio lida naquele momento;
-- a Silver fica com a mais recente por `negocio_id`.
CREATE TABLE IF NOT EXISTS ${self()} (
  negocio_id          STRING    NOT NULL OPTIONS(description="Id do deal no Hubspot"),
  nome                STRING    NOT NULL OPTIONS(description="dealname"),
  estagio             STRING    NOT NULL OPTIONS(description="dealstage — estágio no funil"),
  pipeline            STRING    NOT NULL OPTIONS(description="Funil ao qual o negócio pertence"),
  valor               NUMERIC            OPTIONS(description="amount, em BRL; nulo quando não preenchido"),
  data_fechamento     DATE               OPTIONS(description="closedate; nulo enquanto o negócio está aberto"),
  criado_em           TIMESTAMP NOT NULL OPTIONS(description="createdate"),
  modificado_em       TIMESTAMP NOT NULL OPTIONS(description="hs_lastmodifieddate — é por ele que a janela filtra"),

  _ingestao_id        STRING    NOT NULL OPTIONS(description="Identificador da execução de ingestão"),
  _ingestao_timestamp TIMESTAMP NOT NULL OPTIONS(description="Quando o registro entrou no lake"),
  _fonte              STRING    NOT NULL OPTIONS(description="Identificador da fonte"),
  _schema_versao      STRING    NOT NULL OPTIONS(description="Versão do contrato lido na origem")
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY negocio_id
OPTIONS(description="Negócios do CRM Hubspot — camada Bronze, append-only");

config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["codigo_usina"],
    nonNull: ["codigo_usina"]
  }
}

-- Silver: cadastro vigente de usinas — uma linha por empreendimento.
-- Dedup por codigo_usina: vence a ingestão mais recente. É esta view que
-- fornece `codigo_usina` como dimensão comum para as demais fontes.
SELECT
  data_referencia,
  CAST(NULL AS STRING) AS submercado,   -- a ANEEL publica UF, não submercado
  codigo_usina,
  CAST(NULL AS STRING) AS agente_ccee,  -- o cadastro não traz o agente CCEE
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  nome,
  uf,
  tipo_geracao,
  fase,
  origem_combustivel,
  fonte_combustivel,
  data_entrada_operacao,
  potencia_outorgada_kw,
  potencia_fiscalizada_kw,
  garantia_fisica_kw,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "aneel_siga")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY codigo_usina
  ORDER BY _ingestao_timestamp DESC
) = 1

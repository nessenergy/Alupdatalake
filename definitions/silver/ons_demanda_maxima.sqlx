config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "submercado"],
    nonNull: ["data_referencia", "submercado"],
    rowConditions: [
      "submercado IN ('N','NE','S','SE')",
      // Vazio na origem é nulo: a asserção só recusa o negativo, que não existe fisicamente.
      "demanda_integralizada_mwmed IS NULL OR demanda_integralizada_mwmed >= 0",
      "demanda_instantanea_mw IS NULL OR demanda_instantanea_mw >= 0"
    ]
  }
}

-- Silver: demanda máxima diária higienizada e deduplicada.
-- Dedup por (data_referencia, submercado): o ONS revisa dado publicado, então
-- vence a ingestão mais recente. A sigla já chega aparada do conector (a
-- origem a publica com espaços à direita); a asserção de domínio garante.
SELECT
  data_referencia,
  submercado,
  CAST(NULL AS STRING) AS codigo_usina,  -- demanda é agregada por subsistema
  CAST(NULL AS STRING) AS agente_ccee,   -- idem
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem é o ONS, não a CCEE
  nome_subsistema,
  demanda_integralizada_mwmed,
  instante_integralizada,
  demanda_instantanea_mw,
  instante_instantanea,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "ons_demanda_maxima")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, submercado
  ORDER BY _ingestao_timestamp DESC
) = 1

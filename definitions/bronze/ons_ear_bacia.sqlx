config {
  type: "operations",
  schema: "bronze",
  hasOutput: true,
  tags: ["bronze"]
}

-- Bronze: energia armazenada (EAR) diária por bacia (ONS). Aditivo 01.
CREATE TABLE IF NOT EXISTS ${self()} (
  data_referencia            DATE      NOT NULL OPTIONS(description="Dia de referência da EAR"),
  bacia                      STRING    NOT NULL OPTIONS(description="Nome curto da bacia (nomecurto da origem), em maiúsculas"),
  ear_max_mwmes              NUMERIC   NOT NULL OPTIONS(description="Capacidade máxima de armazenamento da bacia, em MWmês"),
  ear_verificada_mwmes       NUMERIC   NOT NULL OPTIONS(description="Energia armazenada verificada no dia, em MWmês"),
  ear_verificada_percentual  NUMERIC   NOT NULL OPTIONS(description="ear_verificada_mwmes como percentual de ear_max_mwmes; pode passar de 100"),

  _ingestao_id        STRING    NOT NULL,
  _ingestao_timestamp TIMESTAMP NOT NULL,
  _fonte              STRING    NOT NULL,
  _schema_versao      STRING    NOT NULL
)
PARTITION BY DATE(_ingestao_timestamp)
CLUSTER BY data_referencia, bacia
OPTIONS(description="EAR diária por bacia — camada Bronze, append-only");

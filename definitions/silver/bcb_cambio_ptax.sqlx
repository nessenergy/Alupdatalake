config {
  type: "view",
  schema: "silver",
  tags: ["silver"],
  assertions: {
    uniqueKey: ["data_referencia", "tipo_boletim"],
    nonNull: ["data_referencia", "tipo_boletim"],
    rowConditions: [
      "cotacao_compra > 0 AND cotacao_venda > 0",
      "cotacao_venda >= cotacao_compra"
    ]
  }
}

-- Silver: PTAX higienizada, deduplicada e com as dimensões comuns.
-- Dedup: para cada (data_referencia, tipo_boletim), vence a ingestão mais recente.
-- Faixas (issue #110): venda abaixo da compra é inversão de spread — não
-- acontece em boletim do BCB, e se aparecer é troca de coluna na origem. O
-- `cotacao_media` desta view sairia errado sem ninguém notar.
SELECT
  data_referencia,
  CAST(NULL AS STRING)  AS submercado,      -- câmbio não é dado de submercado
  CAST(NULL AS STRING)  AS codigo_usina,    -- idem
  CAST(NULL AS STRING)  AS agente_ccee,     -- idem
  FORMAT_DATE('%Y-%m', data_referencia) AS periodo_apuracao,
  CAST(NULL AS STRING) AS periodo_apuracao_ccee,  -- a origem não declara período próprio
  tipo_boletim,
  data_hora_cotacao,
  cotacao_compra,
  cotacao_venda,
  (cotacao_compra + cotacao_venda) / 2 AS cotacao_media,
  _ingestao_id,
  _ingestao_timestamp
FROM ${ref("bronze", "bcb_cambio_ptax")}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY data_referencia, tipo_boletim
  ORDER BY _ingestao_timestamp DESC
) = 1
